# Page listing downloadable files (use only sites you are authorised to access)
START_URL=
LINK_SELECTOR=a
FILE_EXTENSIONS=.pdf,.zip,.txt,.csv
# CSS selector of the "next page" control; leave empty for single-page sites
NEXT_SELECTOR=
MAX_PAGES=50
DOWNLOAD_DIR=downloads
THROTTLE_SECONDS=1
HEADLESS=true
# Optional login
LOGIN_URL=
SITE_USERNAME=
SITE_PASSWORD=
